#!/usr/bin/env python3
"""受控的 xiaoai-bridge HTTP 客户端；不提供远程 shell。"""

import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request
import uuid


def request(path, method="GET", payload=None, timeout=30):
    base = os.environ.get("OPENXIAOAI_BASE_URL", "http://127.0.0.1:9092").rstrip("/")
    body = None if payload is None else json.dumps(payload, ensure_ascii=False).encode()
    req = urllib.request.Request(
        base + path,
        data=body,
        method=method,
        headers={"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as response:
            return json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        try:
            detail = json.loads(exc.read().decode("utf-8"))
        except Exception:
            detail = {"error": exc.reason}
        raise RuntimeError(f"HTTP {exc.code}: {detail}") from exc
    except urllib.error.URLError as exc:
        raise RuntimeError(f"请求失败: {exc.reason}") from exc


def main():
    parser = argparse.ArgumentParser(description="XiaoAI Bridge 受控工具")
    sub = parser.add_subparsers(dest="action", required=True)

    command = sub.add_parser("xiaoai_command", aliases=["command"], help="静默提交自然语言原生指令")
    command.add_argument("text")
    command.add_argument("--request-id", required=True)
    command.add_argument("--session-key", default="agent:xiaoai-doubao:default")
    command.add_argument("--timeout-ms", type=int, default=10000)

    operation = sub.add_parser("operation", help="查询操作记录")
    operation.add_argument("request_id")
    delete = sub.add_parser("delete", help="删除一条操作记录")
    delete.add_argument("request_id")
    operations = sub.add_parser("operations", help="查询最近操作记录")
    operations.add_argument("--limit", type=int, default=50)
    operations.add_argument("--session-key")

    announce = sub.add_parser("xiaoai_announce", aliases=["announce", "tts"], help="受控播报文字")
    announce.add_argument("content")
    announce.add_argument("--speaker", "-s")
    announce.add_argument("--speed", type=float, default=1.0)
    announce.add_argument("--emotion", "-e")
    announce.add_argument("--context", "-c")
    announce.add_argument("--language")
    announce.add_argument("--dialect")
    announce.add_argument("--request-id", required=True)
    announce.add_argument("--session-key", default="agent:xiaoai-doubao:default")
    announce.add_argument("--timeout-ms", type=int, default=120000)
    status = sub.add_parser("xiaoai_status", aliases=["status"])
    status.add_argument("--session-key", default="agent:xiaoai-doubao:default")
    sub.add_parser("health")
    interrupt = sub.add_parser("xiaoai_interrupt", aliases=["interrupt"])
    interrupt.add_argument("--request-id", required=True)
    interrupt.add_argument("--session-key", default="agent:xiaoai-doubao:default")
    voices = sub.add_parser("voices")
    voices.add_argument("--version", choices=["1.0", "2.0", "all"], default="all")

    args = parser.parse_args()
    try:
        if args.action in ("xiaoai_command", "command"):
            result = request("/api/xiaoai/command", "POST", {
                "command": args.text,
                "request_id": args.request_id,
                "session_key": args.session_key,
                "silent": True,
                "timeout_ms": args.timeout_ms,
            }, timeout=args.timeout_ms / 1000 + 10)
        elif args.action == "operation":
            result = request("/api/xiaoai/operations/" + urllib.parse.quote(args.request_id, safe=""))
        elif args.action == "delete":
            result = request(
                "/api/xiaoai/operations/" + urllib.parse.quote(args.request_id, safe=""),
                "DELETE",
            )
        elif args.action == "operations":
            query = urllib.parse.urlencode({k: v for k, v in {"limit": args.limit, "session_key": args.session_key}.items() if v is not None})
            result = request("/api/xiaoai/operations?" + query)
        elif args.action in ("xiaoai_announce", "announce", "tts"):
            payload = {"text": args.content, "speed": args.speed, "request_id": args.request_id,
                       "session_key": args.session_key, "timeout_ms": args.timeout_ms}
            if args.speaker: payload["speaker_id"] = args.speaker
            if args.emotion: payload["emotion"] = args.emotion
            if args.context: payload["context_texts"] = [args.context]
            if args.language: payload["explicit_language"] = args.language
            if args.dialect: payload["explicit_dialect"] = args.dialect
            result = request("/api/xiaoai/announce", "POST", payload, timeout=args.timeout_ms / 1000 + 10)
        elif args.action in ("xiaoai_status", "status"):
            result = request("/api/xiaoai/status", "POST", {"request_id": str(uuid.uuid4()), "session_key": args.session_key})
        elif args.action == "health":
            result = request("/api/health")
        elif args.action in ("xiaoai_interrupt", "interrupt"):
            result = request("/api/xiaoai/interrupt", "POST", {"request_id": args.request_id, "session_key": args.session_key})
        else:
            result = request("/api/tts/doubao_voices?version=" + args.version)
        sys.stdout.write(json.dumps(result, ensure_ascii=False, indent=2) + "\n")
        if result.get("success") is False:
            return 2
    except Exception as exc:
        sys.stderr.write(f"错误: {exc}\n")
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
