# 第一期原生唤醒模式；这些字段不会被启动脚本自动加载。
WAKE_MODE=native
# 兼容旧 NATIVE_WAKE_ENABLE=1；迁移后删去旧开关，避免冲突。
CONFIG_PATH=config.native-wake.py
AUDIO_INPUT_ENABLE=1
XIAOZHI_ENABLE=0
OPENCLAW_ENABLE=0
OPENCLAW_ENABLED=0
OPENAI_ENABLE=0
QWENPAW_ENABLE=0
API_SERVER_ENABLE=0
# 与音箱 Client 一致，仅在本机私有环境配置。
OPEN_XIAOAI_TOKEN=

# 混合模式示例：WAKE_MODE=mixed，CONFIG_PATH=config.mixed-wake.py，OPENAI_ENABLE=1。
# 新开关不会自动修改既有部署，切换前先离线检查。
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_KEY=
