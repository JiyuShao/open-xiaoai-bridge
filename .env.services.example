# Bridge runtime variables: one template, one private server file.
# Copy to .env.services on the server; that private file is ignored by Git.
# Inject using Compose services.<service>.env_file; this file is not auto-loaded.
# Applying mode or playback changes requires a separate deployment.

# Startup defaults preserve native wake mode. Do not enable mixed mode yet.
WAKE_MODE=native
LOGLEVEL=INFO
OPEN_XIAOAI_TOKEN=
AUDIO_INPUT_ENABLE=1
XIAOZHI_ENABLE=0
OPENCLAW_ENABLE=0
OPENCLAW_ENABLED=0
OPENAI_ENABLE=0
QWENPAW_ENABLE=0
API_SERVER_ENABLE=0
# Docker 内原生 Hermes 访问 Bridge 时监听容器网卡；必须配置 Token，勿发布9092。
API_SERVER_HOST=0.0.0.0

# Opt-in only. Requires local VAD/ASR models, /data mount and native Hermes API.
AMBIENT_RECORDING_ENABLE=0

# Hermes chat connection.

# Required: use addresses reachable from Bridge. localhost means Bridge itself.
# Examples: http://192.168.1.2:8642/v1 and http://192.168.1.2:8123. Verify ports.
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
# Enable Hermes Chat Completions SSE after a local silent fixture passes.
HERMES_CHAT_STREAMING_ENABLE=0
# Optional visual feedback for 豆包豆包. Uses the LX06 firmware's
# /bin/show_led + /bin/shut_led and never sends a native wake event.
HERMES_LED_FEEDBACK_ENABLE=1
HERMES_LED_FEEDBACK_PATTERN=2
HERMES_LED_FEEDBACK_DURATION=1.0
HERMES_LED_FEEDBACK_REFRESH_SECONDS=0.8

# Playback-time custom wake interruption is disabled unless an audio path
# with a verified echo reference is installed. Both flags must be 1 to opt in.
BARGE_IN_ENABLE=0
BARGE_IN_ECHO_REFERENCE=0

# Native Hermes skill -> Bridge. Deployment synchronizes these values into
# Hermes runtime; edit this unified file and rerun install_hermes_bridge.sh.
OPENXIAOAI_BASE_URL=http://xiaoai-ai:9092

# Home Assistant connection.
HA_BASE_URL=
HA_TOKEN=

# HA tools: allow reads only; no device control, rules or tasks.
HA_ENABLE=1
HA_READ_ONLY=1
HA_ALLOW_ALL=0
# Bridge HA tools require real entity IDs; {} is a placeholder, not a usable list.
# Example: HA_ENTITIES_JSON='{"sensor.temperature":{"name":"Living room temperature","native":false}}'
HA_ENTITIES_JSON='{}'

# scripts.verify_live_readonly: optional state and last-24-hour history checks.
# Example: HA_ENTITY_IDS=sensor.temperature,light.living
HA_ENTITY_IDS=
# Example: HA_HISTORY_ENTITY=sensor.temperature
HA_HISTORY_ENTITY=

# Doubao HTTP TTS: API Key from the speech console; its display name is not required.
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_SPEAKER=zh_female_vv_uranus_bigtts
DOUBAO_TTS_SPEED=1.0

# HA_READ_ONLY=1 is not an audio mute switch.
